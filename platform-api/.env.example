DATABASE_URL=postgresql://orangemoon:local-orangemoon@127.0.0.1:54329/orangemoon?schema=public
PLATFORM_PORT=17400
PLATFORM_BODY_LIMIT_MB=128
PLATFORM_MAX_CONCURRENT_GENERATIONS=4
PLATFORM_ALLOWED_ORIGINS=http://127.0.0.1:4311,http://localhost:4311
PLATFORM_COOKIE_SECURE=false
PLATFORM_ALLOW_FIRST_USER_ADMIN=true
PLATFORM_SESSION_DAYS=30
PLATFORM_IP_HASH_SALT=replace-with-a-random-secret

# 内测人工充值。正式上线前改用商户支付，并把收款码放在受控 HTTPS 地址。
MANUAL_ALIPAY_ENABLED=true
MANUAL_ALIPAY_PAYEE=橙月画布
MANUAL_ALIPAY_QR_URL=
MANUAL_ALIPAY_INSTRUCTIONS=转账时填写充值订单号，到账后由管理员确认。
MANUAL_WECHAT_ENABLED=true
MANUAL_WECHAT_PAYEE=橙月画布
MANUAL_WECHAT_QR_URL=
MANUAL_WECHAT_INSTRUCTIONS=转账时填写充值订单号，到账后由管理员确认。

# 官方模型供应商密钥。macOS 本地运行也可继续从 Keychain 读取。
METAJING_API_KEY=
MINIMAX_AUDIO_API_KEY=
MINIMAX_DEFAULT_VOICE_ID=
# MetaJing 美元额度按当前账号的实际采购成本折算；MiniMax 使用真实美元汇率。
PLATFORM_METAJING_USD_TO_CNY=1.0
PLATFORM_MINIMAX_USD_TO_CNY=7.3
PLATFORM_PRICE_MARKUP=1.65
PLATFORM_AGENT_INPUT_CREDITS_PER_MILLION=18.563
PLATFORM_AGENT_CACHED_INPUT_CREDITS_PER_MILLION=1.857
PLATFORM_AGENT_OUTPUT_CREDITS_PER_MILLION=111.375
PLATFORM_AGENT_RESERVE_CREDITS=2
CANVAS_AGENT_INTERNAL_SECRET=orangemoon-local-agent-billing-secret
