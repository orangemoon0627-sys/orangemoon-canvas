[Unit]
Description=Back up Orange Moon Canvas PostgreSQL
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/opt/orangemoon-canvas
ExecStart=/opt/orangemoon-canvas/backup.sh
UMask=0077
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
